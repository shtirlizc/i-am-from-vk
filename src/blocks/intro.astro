---
import Title from "../components/title.astro";
import Container from "../components/container.astro";
import Link from "../components/link.astro";
import Image from "astro/components/Image.astro";
import leftPhoto from "../assets/images/intro/intro-img1.webp";
import cathedral from "../assets/images/intro/intro-img3.webp";
import rightPhoto from "../assets/images/intro/intro-img2.webp";
import arrow from "../assets/images/intro/intro-decoration1.webp";
import Description from "./description.astro";
---

<section class="intro">
  <Container>
    <div class="intro__body">
      <Image class="intro__photo-left" src={leftPhoto} alt="" />
      <Title>Мы все — одна большая команда VK</Title>
      <div class="intro__content">
        <div class="intro__lead">
          <p>
            Мы работаем вместе, при этом у каждого из нас своя география, свои
            любимые места и истории.
          </p>
          <p>
            Этот сайт — наш первый шаг к созданию карты любимых мест сотрудников
            VK. Пока мы запускаем его в пилотном формате и хотим рассказать о
            нас через города, в которых мы родились или живём сейчас.
          </p>
        </div>
        <div class="intro__description">
          <Image class="intro__cathedral" src={cathedral} alt="" />

          <Description>
            <p>
              Мы знаем их не по туристическим буклетам, а изнутри: где выпить
              самый вкусный кофе, куда сбежать от суеты, какие дворы хранят
              маленькие городские истории и где находятся необычные музеи,
              о которых не рассказывают гиды.
            </p>
            <p>
              Здесь собираем любимые места наших сотрудников — чтобы благодаря
              друг другу увидеть знакомые города по‑новому или найти интересные
              маршруты для следующих путешествий. Это возможность поделиться
              частичкой своего мира с коллегами и открыть для себя их мир
              через личные рекомендации и советы.
            </p>
          </Description>
        </div>
      </div>
      <div class="intro__button">
        <Link href="https://vk.ru" isTargetBlank>
          <span style="font-size: 24px">Рассказать о любимом месте</span>
        </Link>
        <Image class="intro__arrow" src={arrow} alt="" />
        <Image
          class="intro__photo-right"
          width={894}
          height={894}
          src={rightPhoto}
          alt=""
        />
      </div>
    </div>
  </Container>
</section>

<style>
  .intro {
    & .intro__body {
      position: relative;
      display: flex;
      flex-direction: column;
      max-width: var(--content-width);
      margin-inline: auto;
      margin-top: -33px;

      /* desktop */
      @media (width >= 960px) {
        gap: var(--space24);
      }
    }

    & .intro__content {
      display: flex;
      flex-direction: column;

      & > div {
        /* desktop */
        @media (width >= 960px) {
          display: flex;
          flex-direction: column;
        }
      }

      /* desktop */
      @media (width >= 960px) {
        gap: var(--space36);
      }
    }

    & .intro__lead {
      font-weight: 600;
      font-size: 32px;
      line-height: 1.3;
      color: var(--color-text-secondary);

      /* desktop */
      @media (width >= 960px) {
        gap: 34px;
      }
    }

    & .intro__description {
      position: relative;

      /* desktop */
      @media (width >= 960px) {
        gap: var(--space32);
      }
    }

    & .intro__button {
      position: relative;
      align-self: center;
      text-align: center;

      /* desktop */
      @media (width >= 960px) {
        margin-block-start: calc(64px - var(--space24));
      }
    }

    & .intro__photo-left,
    & .intro__cathedral,
    & .intro__photo-right,
    & .intro__arrow {
      display: none;
      position: absolute;
      block-size: auto;
      pointer-events: none;

      /* desktop */
      @media (width >= 960px) {
        display: block;
      }
    }

    & .intro__photo-left {
      /* desktop */
      @media (width >= 960px) {
        inset-block-start: 53px;
        inset-inline-end: calc(100% + 177px);
        inline-size: 230px;
      }
    }

    & .intro__cathedral {
      /* desktop */
      @media (width >= 960px) {
        inline-size: 395px;
        inset-block-start: -210px;
        inset-inline-end: calc(100% - 31px);
      }
    }

    & .intro__photo-right {
      /* desktop */
      @media (width >= 960px) {
        inset-inline-start: calc(100% + 177px);
        inset-block-start: -200px;
      }
    }

    & .intro__arrow {
      /* desktop */
      @media (width >= 960px) {
        inline-size: 327px;
        inset-inline-end: calc(100% + 76px);
        inset-block-start: -40px;
      }
    }
  }
</style>
