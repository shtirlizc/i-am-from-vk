---
import { Image } from "astro:assets";
import Title from "../components/title.astro";
import Description from "./description.astro";
import Map from "../assets/svg/map.svg";
import Container from "../components/container.astro";
import RoutesCard from "../components/routes-card.astro";
import PrevPointIcon from "../assets/svg/prev.svg";
import NextPointIcon from "../assets/svg/next.svg";

import pinDecoration from "../assets/images/routes/routes-img2.webp";
import starDecoration from "../assets/images/routes/routes-img1.webp";
---

<section id="routes" class="routes">
  <div class="routes__title">
    <Title>Маршруты от своих</Title>
  </div>
  <div class="routes__description">
    <Description>
      <p>
        На карте проекта уже собрали десятки городов и рекомендаций от ребят
        из разных команд VK. Нажмите на флажок, чтобы узнать, кто откуда,
        и найти свежие идеи и направления для путешествий.
      </p>
      <p>
        А мы продолжаем наполнять карту новыми историями и интересными
        локациями.
      </p>
    </Description>
  </div>

  <Container>
    <div class="routes__nav">
      <button
        type="button"
        data-route-prev
        aria-label="Предыдущая точка"
        aria-controls="routes-card"
      >
        <PrevPointIcon aria-hidden="true" focusable="false" />
      </button>
      <button
        type="button"
        data-route-next
        aria-label="Следующая точка"
        aria-controls="routes-card"
      >
        <NextPointIcon aria-hidden="true" focusable="false" />
      </button>
    </div>

    <div class="routes__map">
      <Image class="routes__decoration-left" src={pinDecoration} alt="" />
      <Image class="routes__decoration-right" src={starDecoration} alt="" />
      <div class="routes__body">
        <Map />
      </div>

      <RoutesCard />
    </div>
  </Container>
</section>

<style>
  .routes {
    text-align: center;
    margin-top: 171px;

    & .routes__title {
      max-width: var(--content-width);
      margin-inline: auto;
    }

    & .routes__description {
      margin-top: var(--space32);
      max-width: var(--content-width-sm);
      margin-inline: auto;
    }

    & .routes__nav {
      position: relative;
      display: flex;
      justify-content: flex-end;
      gap: 10px;

      button {
        border: none;
        padding: 0;
        background: none;
        cursor: pointer;
        border-radius: 50%;
        font-size: 0;

        & :global(circle),
        & :global(path) {
          transition: fill var(--transition);
        }

        &:hover,
        &:focus-visible {
          & :global(circle) {
            fill: var(--color-primary);
          }

          & :global(path) {
            fill: var(--color-white);
          }
        }
      }
    }

    & .routes__map {
      position: relative;
      margin-top: var(--space12);
    }

    & .routes__decoration-left,
    & .routes__decoration-right {
      display: none;
      position: absolute;
      block-size: auto;
      pointer-events: none;

      /* desktop */
      @media (width >= 960px) {
        display: block;
      }
    }

    & .routes__decoration-left {
      /* desktop */
      @media (width >= 960px) {
        inline-size: 1151px;
        inset-block-start: -352px;
        inset-inline-end: calc(100% - 412px);
      }
    }

    & .routes__decoration-right {
      /* desktop */
      @media (width >= 960px) {
        inline-size: 1108.5px;
        inset-block-start: calc(100% - 430px);
        inset-inline-start: calc(100% - 420px);
      }
    }

    & .routes__body {
      position: relative;
      background-color: var(--color-white);
      box-shadow: 0 4px 4px 0 #00000040;
      font-size: 0;
      padding: var(--space20);
      border-radius: 24px;

      & :global(.route-marker) {
        cursor: pointer;

        &:focus:not(:focus-visible) {
          outline: none;
        }

        &:focus-visible {
          outline: 2px solid var(--color-primary);
          outline-offset: 3px;
        }

        & :global(.route-marker__icon) {
          transition:
            fill var(--transition),
            fill-opacity var(--transition);
        }

        &:hover,
        &:focus-visible,
        &[aria-pressed="true"] {
          & :global(.route-marker__icon) {
            fill: var(--color-primary);
            fill-opacity: 1;
          }
        }
      }
    }
  }
</style>
