---
import { Image } from "astro:assets";

import Title from "../components/title.astro";
import Description from "./description.astro";
import Link from "../components/link.astro";
import Container from "../components/container.astro";

import arrowImg from "../assets/images/request-link/arrow.webp";
---

<section class="request-link">
  <Container>
    <div class="request-link__content">
      <Title>Знакомимся друг с другом через наши города</Title>
      <div class="request-link__description">
        <Description>
          Поделитесь локациями, которые вы любите и которые вас вдохновляют,
          и помогите коллегам открыть для себя что-то новое и узнать
          о вас немного больше.
        </Description>
      </div>
      <div>
        <span class="request-link__link">
          <Link href="#">
            <span style="font-size: 24px">Я в деле</span>
          </Link>
          <Image src={arrowImg} width={293} height={213} alt="" />
        </span>
      </div>
    </div>
  </Container>
</section>

<style>
  .request-link {
    position: relative;
    text-align: center;
    margin-top: 160px;
    font-size: 24px;
    z-index: 10;

    & .request-link__content {
      display: grid;
      gap: var(--space36);
    }

    & .request-link__description {
      max-width: var(--content-width-sm);
      margin-inline: auto;
    }

    & .request-link__link {
      position: relative;
      display: inline-block;

      img {
        position: absolute;
        top: -20px;
        left: calc(100% + var(--space32));
        pointer-events: none;
      }
    }
  }
</style>
