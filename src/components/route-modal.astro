---
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import PrevPointIcon from "../assets/svg/prev.svg";
import NextPointIcon from "../assets/svg/next.svg";

interface Props {
  routes: CollectionEntry<"routes">[];
}

const { routes } = Astro.props;
const entries = await Promise.all(
  routes.map(async (route) => ({ route, ...(await render(route)) })),
);
---

<dialog
  id="route-dialog"
  class="route-modal"
  data-route-modal
  aria-labelledby="route-dialog-title"
>
  <button
    type="button"
    class="route-modal__nav route-modal__nav--prev"
    data-route-modal-prev
    aria-label="Предыдущий маршрут"
    aria-controls="route-dialog-content"
    disabled={routes.length < 2}
  >
    <PrevPointIcon aria-hidden="true" focusable="false" />
  </button>
  <div class="route-modal__wrap">
    <button
      type="button"
      class="route-modal__close"
      data-route-modal-close
      aria-label="Закрыть маршрут"
      autofocus
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="m6 6 12 12M18 6 6 18"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>
    </button>
    <div class="route-modal__scroll">
      <div id="route-dialog-content" data-route-modal-content />
    </div>
  </div>
  <button
    type="button"
    class="route-modal__nav route-modal__nav--next"
    data-route-modal-next
    aria-label="Следующий маршрут"
    aria-controls="route-dialog-content"
    disabled={routes.length < 2}
  >
    <NextPointIcon aria-hidden="true" focusable="false" />
  </button>
</dialog>

{entries.map(({ route, Content }) => (
  <template data-route-modal-id={route.id}>
    <div class="route-modal__layout">
      <aside class="route-modal__author" aria-label="Автор маршрута">
        <div class="route-modal__avatar" aria-hidden="true">
          {route.data.image ? (
            <Image
              src={route.data.image}
              width={96}
              height={96}
              alt=""
              loading="lazy"
            />
          ) : (
            Array.from(route.data.name)
              .slice(0, 2)
              .join("")
              .toLocaleUpperCase("ru")
          )}
        </div>
        <div>
          <p class="route-modal__name">{route.data.name}</p>
          <p class="route-modal__position">{route.data.position}</p>
        </div>
      </aside>
      <article class="route-modal__article">
        <h2
          id="route-dialog-title"
          class="route-modal__title"
          aria-live="polite"
        >
          {route.data.city}
        </h2>
        <div class="text-content">
          <Content />
        </div>
      </article>
    </div>
  </template>
))}

<style>
  .route-modal {
    --modal-duration: 0.3s;

    position: fixed;
    inset: 0;
    width: min(var(--content-width), calc(100% - var(--space32)));
    max-width: none;
    max-height: 90vh;
    height: fit-content;
    margin: auto;
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
    color: var(--color-text-primary);
    text-align: left;
    opacity: 0;
    transform: scale(0.95);
    transition:
      opacity var(--modal-duration) var(--timing-func),
      transform var(--modal-duration) var(--timing-func),
      overlay var(--modal-duration) var(--timing-func) allow-discrete,
      display var(--modal-duration) var(--timing-func) allow-discrete;

    /* tablet */
    @media (width >= 768px) {
      width: min(var(--content-width), calc(100% - 180px));
    }

    /* reduced-motion */
    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    &[open] {
      opacity: 1;
      transform: scale(1);

      @starting-style {
        opacity: 0;
        transform: scale(0.95);
      }
    }

    &::backdrop {
      background-color: rgb(0 0 0 / 50%);
      backdrop-filter: blur(2px);
      opacity: 0;
      transition:
        opacity var(--modal-duration) var(--timing-func),
        overlay var(--modal-duration) var(--timing-func) allow-discrete,
        display var(--modal-duration) var(--timing-func) allow-discrete;

      /* reduced-motion */
      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }
    }

    &[open]::backdrop {
      opacity: 1;

      @starting-style {
        opacity: 0;
      }
    }
  }

  .route-modal__wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--border-radius20);
    background-color: var(--color-white);
    box-shadow: 0 24px 80px rgb(0 0 0 / 20%);
  }

  .route-modal__nav {
    position: absolute;
    z-index: 1;
    inset-block-start: var(--space8);
    width: 58px;
    height: 58px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    font-size: 0;
    cursor: pointer;

    /* tablet */
    @media (width >= 768px) {
      inset-block-start: 50%;
      transform: translateY(-50%);
    }

    & :global(circle),
    & :global(path) {
      transition: fill var(--transition);
    }

    &:hover:not(:disabled),
    &:focus-visible {
      & :global(circle) {
        fill: var(--color-primary);
      }

      & :global(path) {
        fill: var(--color-white);
      }
    }

    &:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 3px;
    }

    &:disabled {
      opacity: 0.4;
      cursor: default;
    }
  }

  .route-modal__nav--prev {
    inset-inline-start: var(--space12);

    /* tablet */
    @media (width >= 768px) {
      inset-inline-start: -74px;
    }
  }

  .route-modal__nav--next {
    inset-inline-start: 82px;

    /* tablet */
    @media (width >= 768px) {
      inset-inline-start: auto;
      inset-inline-end: -74px;
    }
  }

  .route-modal__close {
    position: absolute;
    z-index: 1;
    inset-block-start: var(--space12);
    inset-inline-end: var(--space12);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--color-bg-main);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: background-color var(--transition);

    &:hover {
      background-color: #e5e7eb;
    }

    &:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 3px;
    }
  }

  .route-modal__scroll {
    max-height: min(90vh, calc(100dvh - var(--space32)));
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    padding: var(--space24);
    padding-block-start: 72px;

    /* tablet */
    @media (width >= 768px) {
      padding: var(--space48);
      padding-block-start: 72px;
    }
  }

  .route-modal__layout {
    display: grid;
    gap: var(--space32);

    /* tablet */
    @media (width >= 768px) {
      grid-template-columns: 200px minmax(0, 1fr);
    }
  }

  .route-modal__author {
    display: flex;
    align-items: center;
    gap: var(--space16);
    min-width: 0;

    /* tablet */
    @media (width >= 768px) {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .route-modal__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 66px;
    height: 66px;
    overflow: hidden;
    border-radius: 50%;
    background-color: var(--color-bg-main);
    color: var(--color-primary);
    font-size: 24px;
    font-weight: 600;

    /* tablet */
    @media (width >= 768px) {
      width: 96px;
      height: 96px;
      font-size: 32px;
    }

    & img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .route-modal__name {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .route-modal__position {
    margin-top: var(--space8);
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .route-modal__article {
    min-width: 0;
  }

  .route-modal__title {
    font-size: 28px;
    font-weight: 600;
    line-height: 1.15;
    overflow-wrap: anywhere;

    /* tablet */
    @media (width >= 768px) {
      font-size: 36px;
    }
  }
</style>

<script>
  const dialog =
    document.querySelector<HTMLDialogElement>("[data-route-modal]");
  const content = dialog?.querySelector<HTMLElement>(
    "[data-route-modal-content]",
  );
  const scroller = dialog?.querySelector<HTMLElement>(".route-modal__scroll");
  const templates = Array.from(
    document.querySelectorAll<HTMLTemplateElement>(
      "template[data-route-modal-id]",
    ),
  );

  if (dialog && content && scroller) {
    const root = document.documentElement;
    let activeIndex = -1;
    let isActive = false;
    let opener: HTMLButtonElement | null = null;
    let scrollPosition = { top: 0, left: 0 };
    let startedOnBackdrop = false;
    let contentAnimation: Animation | null = null;

    const selectRoute = (index: number) => {
      const template = templates[index];
      if (!template) return;
      contentAnimation?.cancel();
      activeIndex = index;
      content.replaceChildren(template.content.cloneNode(true));
      scroller.scrollTo(0, 0);
      if (
        dialog.open &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        contentAnimation = content.animate(
          [
            {
              opacity: 0,
              transform: "scale(0.98)",
              transformOrigin: "top center",
            },
            {
              opacity: 1,
              transform: "scale(1)",
              transformOrigin: "top center",
            },
          ],
          { duration: 200, easing: "ease" },
        );
      }
      document.dispatchEvent(
        new CustomEvent("route:select", {
          detail: template.dataset.routeModalId,
        }),
      );
      opener =
        document.querySelector<HTMLButtonElement>(
          "#routes-card button[data-route-details]",
        ) ?? opener;
    };

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element) || isActive) return;
      const button = event.target.closest<HTMLButtonElement>(
        "button[data-route-details]",
      );
      const point = button?.closest<HTMLElement>(".point-card[data-route-id]");
      if (!button || !point) return;
      const index = templates.findIndex(
        (template) => template.dataset.routeModalId === point.dataset.routeId,
      );
      if (index < 0) return;

      opener = button;
      scrollPosition = { top: window.scrollY, left: window.scrollX };
      selectRoute(index);
      isActive = true;
      root.setAttribute("data-route-modal-open", "");
      dialog.showModal();
    });

    const navigate = (direction: number) => {
      if (!dialog.open || templates.length < 2) return;
      selectRoute(
        (activeIndex + direction + templates.length) % templates.length,
      );
    };
    dialog
      .querySelector("[data-route-modal-prev]")
      ?.addEventListener("click", () => navigate(-1));
    dialog
      .querySelector("[data-route-modal-next]")
      ?.addEventListener("click", () => navigate(1));
    dialog
      .querySelector("[data-route-modal-close]")
      ?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("pointerdown", (event) => {
      startedOnBackdrop = event.target === dialog;
    });
    dialog.addEventListener("click", (event) => {
      if (startedOnBackdrop && event.target === dialog) dialog.close();
      startedOnBackdrop = false;
    });

    dialog.addEventListener("close", async () => {
      contentAnimation?.cancel();
      // Keep the page locked until native CSS exit transitions finish.
      await Promise.allSettled(
        dialog.getAnimations().map((animation) => animation.finished),
      );
      if (dialog.open) return;
      root.removeAttribute("data-route-modal-open");
      window.scrollTo({ ...scrollPosition, behavior: "instant" });
      if (opener?.isConnected) opener.focus({ preventScroll: true });
      opener = null;
      isActive = false;
    });
  }
</script>
