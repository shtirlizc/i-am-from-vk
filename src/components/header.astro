---
import Logo from "./logo.astro";
import Container from "./container.astro";
import Link from "./link.astro";
---

<header class="header">
  <Container>
    <div class="header__content">
      <Logo />
      <nav>
        <Link href="#routes" color="text" view="link">
          Наши маршруты
        </Link>
        <Link href="https://vk.ru" isTargetBlank color="text" view="outline">
          Принять участие
        </Link>
      </nav>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    height: var(--header);
    background-color: var(--color-bg-main);

    @supports (animation-timeline: scroll(root block)) and
      (animation-range: 0 400px) {
      animation: header-shrink linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 400px;
    }

    & .header__content {
      display: flex;
      justify-content: space-between;
      align-items: center;

      nav {
        display: flex;
        gap: 60px;
      }
    }
  }

  @keyframes header-shrink {
    from {
      height: var(--header);
      background-color: transparent;
      box-shadow: 0 4px 16px rgb(0 0 0 / 0%);
    }

    to {
      //height: calc(var(--header) - 60px);
      background-color: var(--color-bg-main);
      box-shadow: 0 4px 16px rgb(0 0 0 / 8%);
    }
  }
</style>
