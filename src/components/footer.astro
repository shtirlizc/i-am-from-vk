---
import { Image } from "astro:assets";

import Container from "./container.astro";
import Logo from "./logo.astro";

import cityImg from "../assets/images/footer/city.webp";
import bgImg from "../assets/images/footer/bg.webp";
import arrowImg from "../assets/images/footer/arrow.webp";

const year = new Date().getFullYear();
---

<footer class="footer">
  <Container>
    <div class="footer__content">
      <Logo />
      <p>{year}</p>
    </div>
  </Container>

  <div class="footer__image">
    <div class="arrow">
      <Image src={arrowImg} width={587} height={427} alt="" />
    </div>

    <div class="bg">
      <Image src={bgImg} width={2165} height={497} alt="" />
    </div>

    <div class="city">
      <Image src={cityImg} width={2279} height={448} alt="" />
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: 95px;

    & .footer__content {
      position: relative;
      z-index: 5;
      display: flex;
      justify-content: space-between;
      align-items: center;

      p {
        font-weight: 600;
        font-size: 13px;
        line-height: 23px;
        cursor: default;
      }
    }

    & .footer__image {
      position: relative;
      margin: -55px 50px 0 0;

      & .arrow {
        position: absolute;
        z-index: 2;
        inline-size: 295px;
        inset-block-start: -158px;
        inset-inline-start: calc(50% + 158px);

        & img {
          display: block;
          inline-size: 100%;
          block-size: auto;
        }
      }

      /* mobile */
      @media (width < 560px) {
        & .arrow {
          inline-size: 150px;
          inset-block-start: -125px;
          inset-inline-start: calc(50% + 55px);
        }
      }

      /* tablet */
      @media (width >= 768px) {
        & .arrow {
          inset-inline-start: calc(50% + 158px);
        }
      }
    }

    .bg {
      position: absolute;
      bottom: -20px;
      left: 50%;
      transform: translate(-50%);
    }

    .city {
      position: relative;
      display: flex;
      justify-content: center;
    }
  }
</style>
