---
import Footer from "../components/footer.astro";
import Head from "../components/head.astro";
import Header from "../components/header.astro";
import Hero from "../blocks/hero.astro";
import Intro from "../blocks/intro.astro";
import Routes from "../blocks/routes.astro";
import Instruction from "../blocks/instruction.astro";
import RequestLink from "../blocks/request-link.astro";
---

<html lang="ru">
  <Head />

  <body id="top">
    <Header />

    <main class="grid">
      <Hero />
      <Intro />
      <Routes />
      <Instruction />
      <RequestLink />
    </main>

    <Footer />
  </body>
</html>

<style>
  .grid {
    --grid-gap: 164px;

    display: grid;
    grid-gap: var(--grid-gap);
    overflow: hidden;

    .intro {
      margin-top: calc(-1 * var(--space36) - var(--grid-gap));
    }
  }
</style>
