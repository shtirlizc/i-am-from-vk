---
import Footer from "../components/footer.astro";
import Head from "../components/head.astro";
import Header from "../components/header.astro";
import Hero from "../blocks/hero.astro";
import Intro from "../blocks/intro.astro";
import Routes from "../blocks/routes.astro";
import Instruction from "../blocks/instruction.astro";
import RequestLink from "../blocks/request-link.astro";
---

<html lang="ru">
  <Head />

  <body id="top">
    <Header />

    <main class="grid">
      <Hero />
      <Intro />
      <Routes />
      <Instruction />
      <RequestLink />
    </main>

    <Footer />
  </body>
</html>

<style>
  .grid {
    display: flow-root;
    overflow-x: clip;
  }
</style>
